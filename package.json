{
  "name": "inklly",
  "version": "1.0.0",
  "description": "Inklly — Modern Print-Shop Automation & Self-Service Document OS",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:render": "npm run build --workspace=packages/shared --workspace=packages/db --workspace=apps/server",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:agent": "npm run dev --workspace=apps/agent"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "typescript": "^5.4.5",
    "@types/node": "^20.11.0",
    "@types/express": "^5.0.6",
    "@types/cors": "^2.8.19"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
