# =====================================================================
# Inklly - Environment Configuration
# =====================================================================

# Server Configuration (Port 4000)
PORT=4000
NODE_ENV=development
# Generate a unique value with at least 32 random bytes for each production environment.
JWT_SECRET=
# Base64-encoded 32-byte key for AES-256-GCM encryption of shop payment secrets.
# Generate with: openssl rand -base64 32
RAZORPAY_CREDENTIALS_ENCRYPTION_KEY=
# Optional for first production boot when the database has no active platform owner.
# Use a unique password of at least 16 characters; remove these bootstrap values after provisioning.
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=
CORS_ORIGIN=http://localhost:3000

# Database Configuration (SQLite local or Supabase PostgreSQL)
# Local SQLite fallback:
# DATABASE_URL=file:./data/inklly.db
# Supabase PostgreSQL (Production):
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DB_PRAGMA_JOURNAL_MODE=WAL
DB_PRAGMA_SYNCHRONOUS=NORMAL

# Storage & Uploads
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25

# WhatsApp Cloud API (Optional - Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Customer payment provider credentials are entered per shop in merchant settings.
# They are encrypted using RAZORPAY_CREDENTIALS_ENCRYPTION_KEY above.

# Edge Print Agent Configuration (Port 8765)
AGENT_PORT=8765
AGENT_SERVER_URL=http://localhost:4000
AGENT_PAIRING_CODE=PAIR-CAMPUS-01
AGENT_LOCAL_QUEUE_DB=./local_queue.db

# Web Frontend Configuration (Port 3000)
VITE_API_BASE=http://localhost:4000/api/v1
VITE_DEFAULT_SHOP_CODE=campus1
