# =====================================================================
# Print Catalyst / Inklly Engine - Environment Configuration
# =====================================================================

# Server Configuration (Port 4000)
PORT=4000
NODE_ENV=development
JWT_SECRET=inklly_super_secret_jwt_key_development_only_change_in_prod
CORS_ORIGIN=http://localhost:3000

# Database Configuration (SQLite local or Supabase PostgreSQL)
# Local SQLite fallback:
# DATABASE_URL=file:./data/inklly.db
# Supabase PostgreSQL (Production):
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DB_PRAGMA_JOURNAL_MODE=WAL
DB_PRAGMA_SYNCHRONOUS=NORMAL

# Storage & Uploads
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=100

# WhatsApp Cloud API (Optional - Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Payment Gateway (Optional - Cashfree / Razorpay / Dynamic UPI)
UPI_MERCHANT_VPA=printcatalyst@upi
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_SECRET=

# Edge Print Agent Configuration (Port 8765)
AGENT_PORT=8765
AGENT_SERVER_URL=http://localhost:4000
AGENT_PAIRING_CODE=PAIR-CAMPUS-01
AGENT_LOCAL_QUEUE_DB=./local_queue.db

# Web Frontend Configuration (Port 3000)
VITE_API_BASE_URL=http://localhost:4000
VITE_DEFAULT_SHOP_CODE=campus1
