{
  "expo": {
    "name": "Inklly",
    "slug": "inklly",
    "scheme": "inklly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F7FB",
    "primaryColor": "#4F46E5",
    "description": "Print anything at your neighbourhood xerox shop. Upload, choose options, pay by UPI or cash.",
    "ios": {
      "bundleIdentifier": "in.inklly.app",
      "supportsTablet": false,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "upi",
          "phonepe",
          "paytmmp",
          "tez",
          "gpay",
          "credpay",
          "whatsapp"
        ],
        "NSLocationWhenInUseUsageDescription": "Inklly uses your location to show print shops near you.",
        "NSCameraUsageDescription": "Inklly uses the camera to scan print shop QR codes and photograph documents to print.",
        "NSPhotoLibraryUsageDescription": "Inklly lets you pick photos and documents to print.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.inklly.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "inklly.vercel.app",
              "pathPrefix": "/p/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#4F46E5"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Inklly uses your location to show print shops near you."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Inklly uses the camera to scan print shop QR codes and photograph documents to print.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withAndroidQueries.js",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
